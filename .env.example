# Copy to .env.local (git-ignored) and fill in from the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration → Config.
# See FIREBASE_SETUP.md for the whole walkthrough.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Who referees online games:
#   client  – the players' browsers, in Firestore transactions (free Spark plan)
#   server  – Cloud Functions, with hands hidden from other players (Blaze plan)
VITE_FIREBASE_AUTHORITY=client

# Only needed with VITE_FIREBASE_AUTHORITY=server, if you deploy the functions
# somewhere other than us-central1 (set CATAN_REGION for the functions to match).
# VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Talk to the local emulator suite (npm run emulators) instead of the real project.
# With this on, any values above work, e.g. VITE_FIREBASE_PROJECT_ID=demo-catan.
# VITE_FIREBASE_EMULATORS=true
